# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env

# Base URL of the Laravel API.
# Development: leave it commented out (as it is) and requests go through the
# proxy defined in vite.config.ts (/api -> http://localhost:8000).
# Do not leave it set to an empty value (VITE_API_URL=), because that breaks the connection.
# Production: uncomment it and set the full backend URL, for example:
# VITE_API_URL=https://api.example.com/api
